# AnkiConnect listens on localhost only, on the machine where Anki runs.
ANKI_CONNECT_URL=http://localhost:8765

# HTTP timeout in seconds. AnkiConnect blocks while a modal dialog is open in
# Anki, so a request can hang until you dismiss it.
ANKI_TIMEOUT=30

# MCP transport: "stdio" (default, for Claude Desktop) or "http".
MCP_TRANSPORT=stdio

# Bind address for the "http" transport only.
HOST=0.0.0.0
PORT=8000
